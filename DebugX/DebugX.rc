//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 187, 102
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About DebugX"
FONT 9, "Segoe UI", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,68,81,50,14
    CTEXT           "DebugX v0.1\n\n(C)2020 Pavel Yosifovich",IDC_STATIC,36,24,114,32
    ICON            IDR_MAINFRAME,IDC_STATIC,6,6,18,17
END

IDD_RUNEXE DIALOGEX 0, 0, 429, 122
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Run Executable"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_EXEPATH,53,7,301,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_BROWSE,360,5,60,18
    EDITTEXT        IDC_ARGS,53,28,301,14,ES_AUTOHSCROLL
    CONTROL         "Stop at initial &breakpoint",IDC_INITIALBREAK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,6,75,93,10
    CONTROL         "Non-invasive attach",IDC_NONINVASIVE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,120,75,80,10
    DEFPUSHBUTTON   "  OK",IDOK,151,101,56,14,BS_CENTER | BS_FLAT | WS_DISABLED
    PUSHBUTTON      "  Cancel",IDCANCEL,223,101,54,14,BS_FLAT
    LTEXT           "Executable:",IDC_STATIC,6,10,39,8
    LTEXT           "Arguments:",IDC_STATIC,6,30,38,8
    LTEXT           "Working directory:",IDC_STATIC,6,52,60,8
    EDITTEXT        IDC_INITIALDIR,72,50,282,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_BROWSEDIR,360,48,60,18
END

IDD_PROCSELECT DIALOGEX 0, 0, 309, 254
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select Process to Attach"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Attach",IDOK,96,235,50,14,WS_DISABLED
    PUSHBUTTON      "Cancel",IDCANCEL,162,235,50,14
    CONTROL         "",IDC_PROCLIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_ALIGNLEFT | LVS_OWNERDATA | WS_BORDER | WS_TABSTOP,7,0,295,219
    PUSHBUTTON      "",IDC_REFRESH,282,227,26,24,BS_ICON
END


